# Copy to .env and adjust as needed.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FLOWS_TOPIC=flows
KAFKA_ALERTS_TOPIC=alerts
KAFKA_CONSUMER_GROUP=sentinel-workers

# Redis  (container maps host 6380 -> 6379 to avoid clashing with a native redis)
REDIS_URL=redis://localhost:6380/0

# Postgres  (container maps host 5434 -> 5432 to avoid clashing with other local postgres)
POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5434/sentinel

# Pipeline
FLOW_SERIALIZATION=json   # json | msgpack
